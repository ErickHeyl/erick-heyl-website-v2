---
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="DJ Mixes">
  <Container>
    <Sectionhead>
      <Fragment slot="title">DJ Mixes</Fragment>
      <Fragment slot="desc">My recorded mixes and DJ projects</Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-8 mx-auto max-w-4xl mt-16">
      <div class="text-center">
        <h2 class="font-bold text-3xl text-[#F7F7F7] mb-6">
          A Passion for Music & Mixing
        </h2>
        <p class="text-lg leading-relaxed text-[#F7F7F7] mb-8">
          DJing is a creative outlet where I explore different genres, craft seamless transitions, and share my love for music. Here you'll find my recorded mixes and sets—everything from house and techno to hip-hop and throwback classics.
        </p>
      </div>

      <a
        href="/dj/requests"
        class="group flex flex-col sm:flex-row items-center gap-4 bg-[#353439] border border-[#555] hover:border-orange-600 rounded-lg p-6 transition text-center sm:text-left"
      >
        <Icon name="mdi:music-note-plus" class="w-10 h-10 text-orange-600 flex-shrink-0" />
        <div class="flex-1">
          <h3 class="font-bold text-xl text-[#F7F7F7]">Coming to the party? Request a song →</h3>
          <p class="text-[#cccccc] text-sm mt-1">Search for a track, add it to the list, and upvote what everyone else wants to hear.</p>
        </div>
      </a>

      <div class="bg-[#353439] border border-[#555] rounded-lg p-8 my-8">
