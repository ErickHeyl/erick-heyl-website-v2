            <p class="text-[#cccccc] text-sm mb-4">House & Dance • 2025</p>
            <iframe 
              width="100%" 
              height="166" 
              scrolling="no" 
              frameborder="no" 
              allow="autoplay" 
              src="https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/socks175/eheyl-35th-birthday-mix&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true"
              class="rounded"
            ></iframe>
            <p class="text-[#cccccc] mt-3">A celebratory mix recorded for my 35th birthday celebration.</p>
          </div>

