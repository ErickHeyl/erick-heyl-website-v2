---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { Icon } from "astro-icon/components";

import { Picture } from "astro:assets";

const horizontalVideo = { src: "https://www.youtube.com/embed/fy1jPwLMvgY", caption: "Tatiana and Johnny Wedding", type: "youtube" };

const verticalVideos = [
  { src: "https://www.youtube.com/embed/S4ryQhjM-vg", caption: "Yelp - The Flower Fields", type: "youtube" },
  { src: "https://www.youtube.com/embed/OPnxxHnJIcE", caption: "Yelp - Rancho Guejito", type: "youtube" },
  { src: "https://www.youtube.com/embed/SaZ7Rjn9Y18", caption: "Yelp - Air and Space Halloween Event", type: "youtube" },
];
---

<Layout title="Home">
  <Container>
    {/* Hero Section */}
    <section class="min-h-[60vh] flex flex-col items-center justify-center bg-[#030000] text-[#F7F7F7] font-sans py-16">
      <h1 class="text-5xl md:text-6xl font-bold mb-8 text-center tracking-wide border-4 border-[#F7F7F7] inline-block px-8 py-3">
        ERICK HEYL
      </h1>
      <p class="text-xl md:text-2xl mb-10 text-center max-w-3xl text-[#F7F7F7] font-light px-4">
        Software Engineer, Videographer, DJ, BBQ Pitmaster, Gym Goer, Father and Husband based in San Diego California
      </p>
      <div class="flex flex-wrap gap-4 justify-center mb-8">
        <a href="/videos" class="px-6 py-3 border-2 border-[#F7F7F7] text-[#F7F7F7] hover:bg-[#F7F7F7] hover:text-black transition font-semibold uppercase">View My Videos</a>
        <a href="/dj" class="px-6 py-3 border-2 border-[#F7F7F7] text-[#F7F7F7] hover:bg-[#F7F7F7] hover:text-black transition font-semibold uppercase">DJ Mixes</a>
        <a href="/contact" class="px-6 py-3 border-2 border-[#F7F7F7] text-[#F7F7F7] hover:bg-[#F7F7F7] hover:text-black transition font-semibold uppercase">Get in Touch</a>
      </div>
    </section>

    {/* Recent Work Section */}
    <section class="py-16 pb-24 bg-[#353439]">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="font-bold text-4xl text-[#F7F7F7] mb-12 text-center uppercase">Recent Work</h2>
        
        {/* Horizontal Video - Full Width */}
        <div class="flex flex-col items-center mb-12">
          <iframe
            src={horizontalVideo.src}
            class="w-full rounded-lg shadow-md mb-2"
            style="max-width:900px;aspect-ratio:16/9;"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
          <span class="text-[#F7F7F7] text-center text-sm mt-2">{horizontalVideo.caption}</span>
        </div>

        {/* Vertical Videos - 3 Column Grid */}
        <div class="grid md:grid-cols-3 gap-8 mb-12">
          {verticalVideos.map(video => (
            <div class="flex flex-col items-center">
              <iframe
                src={video.src}
                class="w-full rounded-lg shadow-md mb-2"
                style="max-width:320px;aspect-ratio:9/16;"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
              <span class="text-[#F7F7F7] text-center text-sm mt-2">{video.caption}</span>
            </div>
          ))}
        </div>

        <div class="text-center mt-12">
          <a href="https://heylproductions.com/portfolio" target="_blank" rel="noopener" class="inline-block px-8 py-3 border-2 border-[#F7F7F7] text-[#F7F7F7] hover:bg-[#F7F7F7] hover:text-black transition font-semibold uppercase">
            View Full Portfolio
          </a>
        </div>
      </div>
    </section>

    {/* Black space after Recent Work */}
    <section class="py-16 bg-[#030000]">
    </section>
  </Container>

  <footer class="bg-[#26262a] text-[#F7F7F7] py-16 mt-0">
    <Container>
      <div class="flex flex-col md:flex-row items-center justify-center gap-8 w-full max-w-4xl mx-auto">
        <div class="w-full md:w-auto text-center md:text-left">
          <span class="font-light">Based in:</span> San Diego, California
        </div>
        <nav class="flex gap-6 w-full md:w-auto justify-center">
          <a href="/" class="hover:bg-[#F7F7F7] hover:text-black px-2 py-1 transition uppercase">Home</a>
          <a href="/videos" class="hover:bg-[#F7F7F7] hover:text-black px-2 py-1 transition uppercase">Videos</a>
          <a href="/dj" class="hover:bg-[#F7F7F7] hover:text-black px-2 py-1 transition uppercase">DJ</a>
          <a href="/contact" class="hover:bg-[#F7F7F7] hover:text-black px-2 py-1 transition uppercase">Contact</a>
        </nav>
        <div class="flex gap-3 justify-center w-full md:w-auto">
          <a href="https://instagram.com/erickheyl" aria-label="Instagram" target="_blank" rel="noopener" class="hover:bg-[#F7F7F7] hover:text-black p-1 transition">
            <Icon name="mdi:instagram" class="w-6 h-6" />
            <span class="sr-only">@erickheyl</span>
          </a>
          <a href="https://youtube.com/@erickheyl8293" aria-label="YouTube" target="_blank" rel="noopener" class="hover:bg-[#F7F7F7] hover:text-black p-1 transition">
            <Icon name="mdi:youtube" class="w-6 h-6" />
            <span class="sr-only">@erickheyl8293</span>
          </a>
          <a 
            href="mailto:erick@erickheyl.com" 
            aria-label="Email Erick" 
            target="_blank" 
            rel="noopener"
            class="hover:bg-[#F7F7F7] hover:text-black p-1 transition"
          >
            <Icon name="mdi:email" class="w-6 h-6" />
            <span class="sr-only">Email Erick</span>
          </a>
        </div>
      </div>
    </Container>
  </footer>
</Layout>
