---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import landingImage from "assets/dean-landing-no-bg.png";

export interface Props {
  title: string;
  /** Optional link-preview (og:image) path, e.g. the party flyer. Defaults to /opengraph.jpg. */
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const { title, image = "/opengraph.jpg" } = Astro.props;

const resolvedImageWithDomain = new URL(image, Astro.site).toString();

const makeTitle = "Erick Heyl";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">

    <!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
    <SEO
      title={makeTitle}
      description="San Diego videographer and DJ - Erick Heyl. Cinematic wedding films, business promos, event coverage, and professional DJ services."
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `Erick Heyl`,
          image: resolvedImageWithDomain,
        },
        image: {
          src: landingImage,
        },
      }}
    />
  </head>
  <body class="bg-[#030000] text-[#F7F7F7]" style="font-family: 'Montserrat', sans-serif;">
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
      
      body {
        background-color: #030000;
        color: #F7F7F7;
        font-family: 'Montserrat', sans-serif;
      }
    </style>
  </body>
</html>
