---
/**
 * Fixed, muted, looping vertical video behind the page.
 * Phones (portrait): the video fills the screen.
 * Wider screens: the sharp 9:16 video sits centered, with a blurred copy filling the sides.
 * A dark overlay keeps text readable; reduced-motion users get the poster frame only.
 */
export interface Props {
  src: string;
  poster?: string;
}

const { src, poster } = Astro.props;
---

<div class="video-bg" aria-hidden="true">
  <video class="video-bg__fill" src={src} poster={poster} autoplay muted loop playsinline preload="auto"></video>
  <video class="video-bg__main" src={src} poster={poster} autoplay muted loop playsinline preload="auto"></video>
  <div class="video-bg__overlay"></div>
</div>

<style>
  .video-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: #030000;
    pointer-events: none;
  }
  .video-bg video {
    position: absolute;
    object-fit: cover;
  }
  /* Blurred, zoomed copy that fills the sides on wide screens. */
  .video-bg__fill {
    inset: -5%;
    width: 110%;
    height: 110%;
    filter: blur(40px) brightness(0.6);
  }
  /* Sharp copy: full screen on portrait, a centered 9:16 column on wide screens. */
  .video-bg__main {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  @media (min-aspect-ratio: 3/4) {
    .video-bg__main {
      left: 50%;
      width: auto;
      aspect-ratio: 9 / 16;
      transform: translateX(-50%);
    }
  }
  @media (max-aspect-ratio: 3/4) {
    .video-bg__fill { display: none; }
  }
  .video-bg__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(3, 0, 0, 0.55), rgba(3, 0, 0, 0.75) 40%, rgba(3, 0, 0, 0.9));
  }
</style>

<script>
  // Respect reduced-motion: stop playback and leave the poster frame showing.
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLVideoElement>(".video-bg video").forEach((v) => {
      v.removeAttribute("autoplay");
      v.pause();
    });
  }
</script>
